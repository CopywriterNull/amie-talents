<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lenny.opshub.brief</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/Desktop/ops-hub/scripts/brief.sh</string>
  </array>
  <!-- 8:05am and 4:05pm, both a few minutes after the bridge and the owed scan,
       so the queue it reports on is the one that was just rebuilt. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>5</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Desktop/ops-hub/data/brief.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Desktop/ops-hub/data/brief.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__NODEBIN__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.local/bin</string>
    <key>HOME</key><string>__HOME__</string>
  </dict>
</dict>
</plist>
