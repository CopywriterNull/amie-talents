<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lenny.opshub.bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/ops-hub/scripts/bridge.sh</string>
  </array>
  <!-- Twice daily: early enough to catch overnight, again after the workday. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>41</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>41</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key>
  <string>__HOME__/ops-hub/data/bridge.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/ops-hub/data/bridge.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__NODEBIN__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.local/bin</string>
    <key>HOME</key><string>__HOME__</string>
  </dict>
</dict>
</plist>
