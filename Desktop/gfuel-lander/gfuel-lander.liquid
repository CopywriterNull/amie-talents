<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>G FUEL — Summer Sale</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style>
    /* ===== RESET ===== */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    img { max-width: 100%; display: block; }
    button { cursor: pointer; border: none; background: none; font-family: inherit; }
    ul { list-style: none; }

    /* ===== CUSTOM PROPERTIES ===== */
    :root {
      --bg-page: #FAF7F2;
      --bg-card: #FFFFFF;
      --color-primary: #3D348B;
      --color-primary-light: #5B4FC7;
      --color-gold: #D4A024;
      --color-gold-light: #F0C75E;
      --color-text: #1A1A1A;
      --color-text-secondary: #6B6B6B;
      --color-success: #2D8F2D;
      --color-urgency: #D94F00;
      --color-border: #E8E4DF;
      --color-white: #FFFFFF;
      --font-family: 'Inter', sans-serif;
      --fs-hero: 48px;
      --fs-heading: 28px;
      --fs-body: 16px;
      --fs-small: 14px;
      --fs-xs: 12px;
      --max-width: 1200px;
      --section-pad: 60px;
      --card-radius: 12px;
      --btn-radius: 8px;
      --gap: 20px;
    }

    /* ===== BASE ===== */
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font-family);
      font-size: var(--fs-body);
      color: var(--color-text);
      background: var(--bg-page);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    .container {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 0 20px;
    }
    .section-heading {
      font-size: var(--fs-heading);
      font-weight: 700;
      text-align: center;
      margin-bottom: 32px;
      color: var(--color-primary);
    }

    /* ===== ANNOUNCEMENT BAR ===== */
    .announcement-bar {
      background: var(--color-primary);
      color: var(--color-white);
      overflow: hidden;
      white-space: nowrap;
      padding: 10px 0;
      font-size: var(--fs-small);
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .announcement-bar__track {
      display: inline-flex;
      animation: marquee 20s linear infinite;
    }
    .announcement-bar__text {
      padding: 0 40px;
      flex-shrink: 0;
    }
    @keyframes marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    /* ===== HERO ===== */
    .hero {
      text-align: center;
      padding: var(--section-pad) 20px;
      background: linear-gradient(180deg, #EDEAFF 0%, var(--bg-page) 100%);
    }
    .hero__badge {
      display: inline-block;
      background: linear-gradient(135deg, var(--color-gold), var(--color-gold-light));
      color: var(--color-text);
      font-size: var(--fs-xs);
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 6px 16px;
      border-radius: 20px;
      margin-bottom: 16px;
    }
    .hero__headline {
      font-size: var(--fs-hero);
      font-weight: 700;
      color: var(--color-primary);
      line-height: 1.1;
      margin-bottom: 12px;
    }
    .hero__subheadline {
      font-size: 20px;
      color: var(--color-text-secondary);
      margin-bottom: 32px;
      font-weight: 400;
    }
    .hero__countdown {
      display: inline-flex;
      gap: 12px;
      background: var(--bg-card);
      border: 2px solid var(--color-primary);
      border-radius: var(--card-radius);
      padding: 16px 32px;
      margin-bottom: 32px;
      animation: pulse-border 2s ease-in-out infinite;
    }
    .hero__countdown-unit {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 60px;
    }
    .hero__countdown-number {
      font-size: 36px;
      font-weight: 700;
      color: var(--color-primary);
      line-height: 1;
    }
    .hero__countdown-label {
      font-size: var(--fs-xs);
      color: var(--color-text-secondary);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-top: 4px;
    }
    .hero__countdown-sep {
      font-size: 36px;
      font-weight: 700;
      color: var(--color-primary);
      line-height: 1;
      align-self: flex-start;
    }
    .hero__cta {
      display: inline-block;
      background: var(--color-primary);
      color: var(--color-white);
      font-size: 18px;
      font-weight: 700;
      padding: 16px 48px;
      border-radius: var(--btn-radius);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 1px;
      transition: transform 0.2s, background 0.2s;
    }
    .hero__cta:hover {
      background: var(--color-primary-light);
      transform: scale(1.02);
    }
    @keyframes pulse-border {
      0%, 100% { box-shadow: 0 0 0 0 rgba(61, 52, 139, 0.3); }
      50% { box-shadow: 0 0 0 8px rgba(61, 52, 139, 0); }
    }

    /* ===== SOCIAL PROOF BAR ===== */
    .social-proof {
      background: var(--bg-card);
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
      padding: 16px 20px;
    }
    .social-proof__inner {
      max-width: var(--max-width);
      margin: 0 auto;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 32px;
      flex-wrap: wrap;
    }
    .social-proof__item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: var(--fs-small);
      color: var(--color-text-secondary);
    }
    .social-proof__stars {
      color: var(--color-gold);
      font-size: 18px;
      letter-spacing: 2px;
    }
    .social-proof__rating {
      font-weight: 700;
      color: var(--color-text);
    }
    .social-proof__icon {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
    }

    /* ===== PRODUCT GRID ===== */
    .products {
      padding: var(--section-pad) 20px;
    }
    .product-grid {
      max-width: var(--max-width);
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--gap);
    }
    .product-card {
      background: var(--bg-card);
      border: 1px solid var(--color-border);
      border-radius: var(--card-radius);
      padding: 16px;
      display: flex;
      flex-direction: column;
      transition: box-shadow 0.2s;
    }
    .product-card:hover {
      box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }
    .product-card__image-wrap {
      position: relative;
      aspect-ratio: 1;
      background: #F5F3EE;
      border-radius: 8px;
      margin-bottom: 12px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .product-card__image {
      width: 80%;
      height: 80%;
      object-fit: contain;
    }
    .product-card__image-placeholder {
      color: var(--color-text-secondary);
      font-size: var(--fs-small);
    }
    .product-card__badge {
      position: absolute;
      top: 8px;
      left: 8px;
      font-size: var(--fs-xs);
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .product-card__badge--new {
      background: var(--color-primary);
      color: var(--color-white);
    }
    .product-card__badge--bestseller {
      background: var(--color-gold);
      color: var(--color-text);
    }
    .product-card__badge--lowstock {
      background: var(--color-urgency);
      color: var(--color-white);
    }
    .product-card__title {
      font-size: var(--fs-body);
      font-weight: 600;
      margin-bottom: 4px;
      color: var(--color-text);
    }
    .product-card__rating {
      font-size: var(--fs-small);
      color: var(--color-gold);
      margin-bottom: 8px;
    }
    .product-card__rating span {
      color: var(--color-text-secondary);
      margin-left: 4px;
    }
    .product-card__price {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }
    .product-card__price-original {
      font-size: var(--fs-small);
      color: var(--color-text-secondary);
      text-decoration: line-through;
    }
    .product-card__price-sale {
      font-size: 18px;
      font-weight: 700;
      color: var(--color-primary);
    }
    .product-card__stock {
      font-size: var(--fs-xs);
      color: var(--color-urgency);
      font-weight: 600;
      margin-bottom: 12px;
    }
    .product-card__actions {
      margin-top: auto;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .product-card__qty {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      border: 1px solid var(--color-border);
      border-radius: var(--btn-radius);
      overflow: hidden;
    }
    .product-card__qty-btn {
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      font-weight: 600;
      color: var(--color-primary);
      background: var(--bg-page);
      transition: background 0.15s;
    }
    .product-card__qty-btn:hover {
      background: var(--color-border);
    }
    .product-card__qty-count {
      width: 48px;
      text-align: center;
      font-size: var(--fs-body);
      font-weight: 700;
      color: var(--color-text);
    }
    .product-card__add-btn {
      background: var(--color-primary);
      color: var(--color-white);
      font-size: var(--fs-small);
      font-weight: 700;
      padding: 12px;
      border-radius: var(--btn-radius);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      transition: background 0.2s, transform 0.2s;
    }
    .product-card__add-btn:hover {
      background: var(--color-primary-light);
      transform: scale(1.02);
    }

    /* ===== TIER DISCOUNT ===== */
    .tiers {
      padding: var(--section-pad) 20px;
      background: var(--bg-card);
    }
    .tiers__grid {
      max-width: 800px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    .tier-card {
      position: relative;
      border: 2px solid var(--color-border);
      border-radius: var(--card-radius);
      padding: 24px 16px;
      text-align: center;
      transition: border-color 0.3s, box-shadow 0.3s;
    }
    .tier-card--active {
      border-color: var(--color-primary);
      box-shadow: 0 4px 20px rgba(61, 52, 139, 0.15);
    }
    .tier-card__best-badge {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background: linear-gradient(135deg, var(--color-gold), var(--color-gold-light));
      color: var(--color-text);
      font-size: var(--fs-xs);
      font-weight: 700;
      padding: 4px 12px;
      border-radius: 20px;
      white-space: nowrap;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .tier-card__qty {
      font-size: var(--fs-heading);
      font-weight: 700;
      color: var(--color-primary);
      margin-bottom: 4px;
    }
    .tier-card__discount {
      font-size: 20px;
      font-weight: 700;
      color: var(--color-primary);
      margin-bottom: 8px;
    }
    .tier-card__price {
      font-size: var(--fs-small);
      color: var(--color-text-secondary);
    }

    /* ===== GIFT LADDER ===== */
    .gifts {
      padding: var(--section-pad) 20px;
    }
    .gifts__grid {
      max-width: 700px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .gift-card {
      display: flex;
      align-items: center;
      gap: 16px;
      background: var(--bg-card);
      border: 2px solid var(--color-border);
      border-radius: var(--card-radius);
      padding: 20px 24px;
      transition: border-color 0.3s, opacity 0.3s;
      opacity: 0.5;
    }
    .gift-card--unlocked {
      border-color: var(--color-success);
      opacity: 1;
    }
    .gift-card__check {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 2px solid var(--color-border);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: background 0.3s, border-color 0.3s;
    }
    .gift-card--unlocked .gift-card__check {
      background: var(--color-success);
      border-color: var(--color-success);
    }
    .gift-card__check-icon {
      color: var(--color-white);
      font-size: 18px;
      font-weight: 700;
      opacity: 0;
      transition: opacity 0.3s;
    }
    .gift-card--unlocked .gift-card__check-icon {
      opacity: 1;
    }
    .gift-card__info {
      flex: 1;
    }
    .gift-card__title {
      font-weight: 600;
      font-size: var(--fs-body);
      margin-bottom: 2px;
    }
    .gift-card__threshold {
      font-size: var(--fs-small);
      color: var(--color-text-secondary);
    }
    .gift-card__value {
      font-size: var(--fs-small);
      font-weight: 700;
      color: var(--color-success);
      white-space: nowrap;
    }

    /* ===== TESTIMONIAL ===== */
    .testimonial {
      padding: var(--section-pad) 20px;
      background: var(--bg-card);
    }
    .testimonial__card {
      max-width: 700px;
      margin: 0 auto;
      text-align: center;
      padding: 40px;
      border: 1px solid var(--color-border);
      border-radius: var(--card-radius);
      background: var(--bg-page);
    }
    .testimonial__stars {
      color: var(--color-gold);
      font-size: 24px;
      letter-spacing: 4px;
      margin-bottom: 16px;
    }
    .testimonial__quote {
      font-size: 18px;
      line-height: 1.7;
      color: var(--color-text);
      margin-bottom: 20px;
      font-style: italic;
    }
    .testimonial__author {
      font-weight: 600;
      color: var(--color-text);
    }
    .testimonial__badge {
      display: inline-block;
      font-size: var(--fs-xs);
      color: var(--color-success);
      font-weight: 600;
      margin-left: 8px;
    }

    /* ===== GUARANTEE ===== */
    .guarantee {
      padding: var(--section-pad) 20px;
      text-align: center;
    }
    .guarantee__icon {
      width: 64px;
      height: 64px;
      margin: 0 auto 16px;
      color: var(--color-primary);
    }
    .guarantee__title {
      font-size: 20px;
      font-weight: 700;
      color: var(--color-primary);
      margin-bottom: 8px;
    }
    .guarantee__text {
      font-size: var(--fs-body);
      color: var(--color-text-secondary);
      max-width: 480px;
      margin: 0 auto;
    }

    /* ===== STICKY FOOTER ===== */
    .sticky-footer {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: var(--bg-card);
      border-top: 2px solid var(--color-primary);
      padding: 12px 20px;
      z-index: 100;
      transform: translateY(100%);
      transition: transform 0.3s ease;
      box-shadow: 0 -4px 20px rgba(0,0,0,0.1);
    }
    .sticky-footer--visible {
      transform: translateY(0);
    }
    .sticky-footer__inner {
      max-width: var(--max-width);
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .sticky-footer__summary {
      display: flex;
      align-items: center;
      gap: 24px;
      flex-wrap: wrap;
    }
    .sticky-footer__items {
      font-weight: 600;
      color: var(--color-text);
    }
    .sticky-footer__pricing {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .sticky-footer__original {
      font-size: var(--fs-small);
      color: var(--color-text-secondary);
      text-decoration: line-through;
    }
    .sticky-footer__discounted {
      font-size: 20px;
      font-weight: 700;
      color: var(--color-primary);
    }
    .sticky-footer__savings {
      font-size: var(--fs-small);
      font-weight: 700;
      color: var(--color-success);
    }
    .sticky-footer__tier {
      font-size: var(--fs-xs);
      font-weight: 700;
      background: linear-gradient(135deg, var(--color-gold), var(--color-gold-light));
      color: var(--color-text);
      padding: 4px 10px;
      border-radius: 4px;
      text-transform: uppercase;
    }
    .sticky-footer__gifts {
      font-size: var(--fs-xs);
      color: var(--color-success);
      font-weight: 600;
    }
    .sticky-footer__checkout {
      background: var(--color-primary);
      color: var(--color-white);
      font-size: var(--fs-body);
      font-weight: 700;
      padding: 14px 40px;
      border-radius: var(--btn-radius);
      text-transform: uppercase;
      letter-spacing: 1px;
      white-space: nowrap;
      transition: background 0.2s, transform 0.2s;
    }
    .sticky-footer__checkout:hover {
      background: var(--color-primary-light);
      transform: scale(1.02);
    }
    .body--has-footer { padding-bottom: 80px; }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 991px) {
      .product-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 767px) {
      :root {
        --fs-hero: 32px;
        --fs-heading: 22px;
        --section-pad: 40px;
      }
      .hero__subheadline { font-size: 16px; }
      .hero__countdown { padding: 12px 16px; gap: 8px; }
      .hero__countdown-number { font-size: 28px; }
      .hero__countdown-unit { min-width: 48px; }
      .hero__cta { padding: 14px 32px; font-size: 16px; }
      .social-proof__inner { gap: 16px; }
      .social-proof__item { font-size: var(--fs-xs); }
      .testimonial__card { padding: 24px; }
      .testimonial__quote { font-size: var(--fs-body); }
      .sticky-footer__inner { flex-direction: column; gap: 8px; }
      .sticky-footer__summary { justify-content: center; gap: 12px; }
      .sticky-footer__checkout { width: 100%; text-align: center; }
    }
    @media (max-width: 479px) {
      .product-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
      .product-card { padding: 12px; }
      .product-card__qty-btn { width: 36px; height: 36px; }
      .tiers__grid { grid-template-columns: 1fr; max-width: 320px; }
      .gift-card { padding: 16px; }
    }
  </style>
</head>
<body>

  <!-- 1. Announcement Bar -->
  <div class="announcement-bar">
    <div class="announcement-bar__track">
      <span class="announcement-bar__text">SUMMER SALE — UP TO 40% OFF + FREE GIFTS</span>
      <span class="announcement-bar__text">FREE SHAKER CUP ON 3+ TUBS</span>
      <span class="announcement-bar__text">SUMMER SALE — UP TO 40% OFF + FREE GIFTS</span>
      <span class="announcement-bar__text">FREE SHAKER CUP ON 3+ TUBS</span>
      <span class="announcement-bar__text">SUMMER SALE — UP TO 40% OFF + FREE GIFTS</span>
      <span class="announcement-bar__text">FREE SHAKER CUP ON 3+ TUBS</span>
      <span class="announcement-bar__text">SUMMER SALE — UP TO 40% OFF + FREE GIFTS</span>
      <span class="announcement-bar__text">FREE SHAKER CUP ON 3+ TUBS</span>
    </div>
  </div>

  <!-- 2. Hero -->
  <section class="hero" id="hero">
    <div class="hero__badge">SUMMER DISCOUNT ACTIVE</div>
    <h1 class="hero__headline">FUEL YOUR SUMMER</h1>
    <p class="hero__subheadline">UP TO 40% OFF WITH FREE GIFTS</p>
    <div class="hero__countdown" id="countdown">
      <div class="hero__countdown-unit">
        <span class="hero__countdown-number" id="countdown-hours">00</span>
        <span class="hero__countdown-label">Hours</span>
      </div>
      <span class="hero__countdown-sep">:</span>
      <div class="hero__countdown-unit">
        <span class="hero__countdown-number" id="countdown-minutes">00</span>
        <span class="hero__countdown-label">Minutes</span>
      </div>
      <span class="hero__countdown-sep">:</span>
      <div class="hero__countdown-unit">
        <span class="hero__countdown-number" id="countdown-seconds">00</span>
        <span class="hero__countdown-label">Seconds</span>
      </div>
    </div>
    <br>
    <a href="#products" class="hero__cta">Shop Now</a>
  </section>

  <!-- 3. Social Proof Bar -->
  <div class="social-proof">
    <div class="social-proof__inner">
      <div class="social-proof__item">
        <span class="social-proof__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="social-proof__rating">4.8/5</span>
        <span>from 12,000+ reviews</span>
      </div>
      <div class="social-proof__item">
        <svg class="social-proof__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>30-Day Money-Back Guarantee</span>
      </div>
      <div class="social-proof__item">
        <svg class="social-proof__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <span>Free Shipping on 2+ Tubs</span>
      </div>
    </div>
  </div>

  <!-- 4. Product Grid -->
  <section class="products" id="products">
    <h2 class="section-heading">Build Your Bundle</h2>
    <div class="product-grid" id="product-grid">
      <!-- Product cards rendered by gfuel-lander.js -->
