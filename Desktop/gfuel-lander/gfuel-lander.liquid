<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>G FUEL — Summer Sale</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* ===== RESET ===== */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    img { max-width: 100%; display: block; }
    button { cursor: pointer; border: none; background: none; font-family: inherit; }
    ul { list-style: none; }

    /* ===== BASE ===== */
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', sans-serif;
      font-size: 16px;
      color: #1A1A1A;
      background: #FAF7F2;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    /* ===== TOP BANNER ===== */
    .top-banner {
      background: #3D348B;
      color: #FFFFFF;
      text-align: center;
      padding: 8px 16px;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    /* ===== HEADER BAR ===== */
    .header-bar {
      background: #FFFFFF;
      border-bottom: 1px solid #E0DDD8;
      padding: 12px 20px;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }
    .header-bar__badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: linear-gradient(135deg, #D4A024, #F0C75E);
      color: #1A1A1A;
      font-size: 11px;
      font-weight: 700;
      padding: 5px 14px;
      border-radius: 20px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .header-bar__sub {
      font-size: 14px;
      color: #6B6B6B;
    }
    .header-bar__timer-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }
    .header-bar__timer {
      display: flex;
      gap: 3px;
      align-items: center;
      background: #FFFFFF;
      border: 1px solid #E0DDD8;
      border-radius: 8px;
      padding: 6px 10px;
    }
    .header-bar__timer-block {
      background: #3D348B;
      color: #FFFFFF;
      font-size: 18px;
      font-weight: 700;
      padding: 4px 8px;
      border-radius: 4px;
      min-width: 36px;
      text-align: center;
      line-height: 1.2;
    }
    .header-bar__timer-sep {
      color: #3D348B;
      font-weight: 700;
      font-size: 18px;
      padding: 0 1px;
    }
    .header-bar__timer-labels {
      display: flex;
      gap: 3px;
      padding: 0 10px;
    }
    .header-bar__timer-label {
      font-size: 9px;
      text-transform: uppercase;
      color: #6B6B6B;
      text-align: center;
      min-width: 36px;
      letter-spacing: 0.5px;
    }

    /* ===== MAIN LAYOUT ===== */
    .main-layout {
      max-width: 1100px;
      margin: 0 auto;
      padding: 32px 20px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: start;
    }

    /* ===== LEFT: MARKETING COLUMN ===== */
    .marketing {
      padding-top: 8px;
    }
    .marketing__headline {
      font-size: 40px;
      font-weight: 700;
      line-height: 1.1;
      color: #2A2552;
      margin-bottom: 10px;
    }
    .marketing__sub {
      font-size: 17px;
      color: #6B6B6B;
      margin-bottom: 24px;
      line-height: 1.5;
    }
    .marketing__benefits {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 28px;
    }
    .marketing__benefit {
      display: flex;
      align-items: center;
      gap: 10px;
      background: #FFFFFF;
      border: 1px solid #E0DDD8;
      border-radius: 8px;
      padding: 11px 16px;
      font-size: 14px;
      font-weight: 600;
      color: #1A1A1A;
    }
    .marketing__benefit-icon {
      font-size: 17px;
      flex-shrink: 0;
    }
    .marketing__hero-image {
      width: 100%;
      max-width: 400px;
      margin: 0 auto;
      aspect-ratio: 3/4;
      background: #F0ECE6;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #6B6B6B;
      font-size: 14px;
      margin-bottom: 24px;
      overflow: hidden;
    }
    .marketing__testimonial {
      background: #FFFFFF;
      border: 1px solid #E0DDD8;
      border-radius: 12px;
      padding: 20px;
    }
    .marketing__testimonial-stars {
      color: #D4A024;
      font-size: 15px;
      letter-spacing: 2px;
      margin-bottom: 4px;
    }
    .marketing__testimonial-label {
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 8px;
      color: #1A1A1A;
    }
    .marketing__testimonial-quote {
      font-size: 14px;
      color: #6B6B6B;
      line-height: 1.6;
      font-style: italic;
      margin-bottom: 12px;
    }
    .marketing__testimonial-author {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .marketing__testimonial-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #E0DDD8;
      flex-shrink: 0;
    }
    .marketing__testimonial-name {
      font-size: 12px;
      font-weight: 600;
      color: #1A1A1A;
    }
    .marketing__testimonial-verified {
      font-size: 10px;
      color: #2D8F2D;
    }

    /* ===== RIGHT: SHOPPING COLUMN ===== */
    .shopping {
      background: #FFFFFF;
      border-radius: 12px;
      border: 1px solid #E0DDD8;
      overflow: hidden;
    }

    /* Trust row */
    .trust-row {
      display: flex;
      justify-content: space-around;
      align-items: center;
      padding: 14px 20px;
      border-bottom: 1px solid #E0DDD8;
      flex-wrap: wrap;
      gap: 8px;
    }
    .trust-row__item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1px;
    }
    .trust-row__stars {
      color: #D4A024;
      font-size: 13px;
      letter-spacing: 1px;
    }
    .trust-row__label {
      font-size: 11px;
      font-weight: 700;
      color: #1A1A1A;
    }
    .trust-row__sublabel {
      font-size: 10px;
      color: #6B6B6B;
    }
    .trust-row__sep {
      width: 1px;
      height: 28px;
      background: #E0DDD8;
      flex-shrink: 0;
    }

    /* Shopping header */
    .shopping__header {
      padding: 20px 24px 10px;
    }
    .shopping__headline {
      font-size: 22px;
      font-weight: 700;
      line-height: 1.25;
      color: #1A1A1A;
      margin-bottom: 12px;
    }
    .shopping__headline span {
      color: #3D348B;
    }

    /* Discount active label */
    .discount-label {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 12px;
      font-weight: 700;
      color: #3D348B;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 14px;
    }
    .discount-label__dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #2D8F2D;
      display: inline-block;
      animation: pulse-dot 2s infinite;
      flex-shrink: 0;
    }
    @keyframes pulse-dot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(0.85); }
    }

    /* ===== PROGRESS BAR ===== */
    .progress-section {
      padding: 0 24px 16px;
    }
    .progress-bar {
      position: relative;
      height: 10px;
      background: #EAE8F0;
      border-radius: 99px;
      margin-bottom: 8px;
      overflow: hidden;
    }
    .progress-bar__track {
      display: flex;
      height: 100%;
      gap: 2px;
    }
    .progress-bar__segment {
      flex: 1;
      background: #EAE8F0;
      border-radius: 99px;
      position: relative;
      overflow: hidden;
      transition: background 0.3s;
    }
    .progress-bar__segment.is-filled {
      background: #3D348B;
    }
    .progress-bar__segment.is-filled::after {
      content: '';
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        -45deg,
        transparent,
        transparent 4px,
        rgba(255,255,255,0.18) 4px,
        rgba(255,255,255,0.18) 8px
      );
      animation: stripe-move 1s linear infinite;
    }
    @keyframes stripe-move {
      from { background-position: 0 0; }
      to { background-position: 16px 0; }
    }
    .progress-milestones {
      display: flex;
      justify-content: space-between;
      padding: 0 0 4px;
    }
    .progress-milestone {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      flex: 1;
      position: relative;
    }
    .progress-milestone__dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: #EAE8F0;
      border: 2px solid #FFFFFF;
      box-shadow: 0 0 0 1px #CFCFCF;
      transition: background 0.3s, box-shadow 0.3s;
      margin-bottom: 2px;
    }
    .progress-milestone.is-active .progress-milestone__dot {
      background: #3D348B;
      box-shadow: 0 0 0 2px #3D348B, 0 0 0 4px rgba(61,52,139,0.18);
    }
    .progress-milestone__label {
      font-size: 10px;
      font-weight: 600;
      color: #9997AA;
      text-align: center;
      white-space: nowrap;
    }
    .progress-milestone.is-active .progress-milestone__label {
      color: #3D348B;
    }
    .progress-milestone__badge {
      font-size: 8px;
      font-weight: 700;
      padding: 1px 5px;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      white-space: nowrap;
    }
    .progress-milestone__badge--popular {
      background: #3D348B;
      color: #FFFFFF;
    }
    .progress-milestone__badge--best {
      background: linear-gradient(135deg, #D4A024, #F0C75E);
      color: #1A1A1A;
    }
    .progress-prices {
      display: flex;
      justify-content: space-between;
      padding: 2px 0 0;
    }
    .progress-price {
      flex: 1;
      text-align: center;
      font-size: 10px;
      color: #9997AA;
      font-weight: 500;
    }
    .progress-price.is-active {
      color: #3D348B;
      font-weight: 700;
    }
    .progress-price__discount {
      font-size: 9px;
      color: #2D8F2D;
      font-weight: 600;
    }

    /* ===== PRODUCT LIST ===== */
    .product-list {
      border-top: 1px solid #E0DDD8;
    }
    .product-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 20px;
      border-bottom: 1px solid #E0DDD8;
      transition: background 0.15s;
    }
    .product-row:hover {
      background: #FAFAF8;
    }
    .product-row.is-selected {
      background: #FFEDD7;
      box-shadow: 0 0 0 2px #010101 inset;
    }
    .product-row__image {
      width: 56px;
      height: 56px;
      border-radius: 8px;
      flex-shrink: 0;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #EAE6DF;
    }
    .product-row__image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .product-row__image-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      color: #6B6B6B;
    }
    .product-row__info {
      flex: 1;
      min-width: 0;
    }
    .product-row__name {
      font-size: 14px;
      font-weight: 700;
      color: #1A1A1A;
      margin-bottom: 2px;
      line-height: 1.3;
    }
    .product-row__desc {
      font-size: 12px;
      color: #6B6B6B;
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .product-row__right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 5px;
      flex-shrink: 0;
    }
    .product-row__badge {
      font-size: 9px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      white-space: nowrap;
    }
    .product-row__badge--new {
      background: #DFE3FF;
      color: #1C00FF;
    }
    .product-row__badge--bestseller {
      background: #FFF6DC;
      color: #8A6400;
    }
    .product-row__badge--lowstock {
      background: #FFF0E6;
      color: #D94F00;
    }
    .product-row__badge--backinstock {
      background: #E8F5E8;
      color: #2D8F2D;
    }
    .product-row__badge--gone {
      background: #F0F0F0;
      color: #9997AA;
    }
    /* Add + button */
    .product-row__add-btn {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: #3D348B;
      color: #FFFFFF;
      border-radius: 100px;
      padding: 6px 14px;
      font-size: 13px;
      font-weight: 600;
      font-family: inherit;
      transition: background 0.15s;
      white-space: nowrap;
    }
    .product-row__add-btn:hover {
      background: #2A2552;
    }
    /* Stepper */
    .product-row__stepper {
      display: inline-flex;
      align-items: center;
      border: 1.5px solid #3D348B;
      border-radius: 100px;
      overflow: hidden;
    }
    .product-row__stepper-btn {
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      font-weight: 600;
      color: #3D348B;
      background: transparent;
      transition: background 0.12s;
      cursor: pointer;
      border: none;
      font-family: inherit;
    }
    .product-row__stepper-btn:hover {
      background: #EAE8F0;
    }
    .product-row__stepper-qty {
      min-width: 28px;
      text-align: center;
      font-size: 13px;
      font-weight: 700;
      color: #3D348B;
      padding: 0 4px;
      background: #FFFFFF;
    }

    /* ===== GIFT SECTION ===== */
    .gift-section {
      border-top: 1px solid #E0DDD8;
      padding: 18px 24px 16px;
    }
    .gift-section__header {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 4px;
    }
    .gift-section__title {
      font-size: 13px;
      font-weight: 700;
      color: #1A1A1A;
    }
    .gift-section__badge {
      background: linear-gradient(135deg, #D4A024, #F0C75E);
      color: #1A1A1A;
      font-size: 9px;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 10px;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }
    .gift-section__deadline {
      font-size: 12px;
      color: #6B6B6B;
      margin-bottom: 14px;
    }
    .gift-section__grid {
      display: flex;
      gap: 10px;
    }
    .gift-item {
      flex: 1;
      text-align: center;
      transition: opacity 0.3s;
    }
    .gift-item__card {
      aspect-ratio: 1;
      border: 1px dashed #CFCFCF;
      border-radius: 8px;
      position: relative;
      overflow: hidden;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #FAFAF8;
      transition: border-color 0.3s;
    }
    .gift-item.is-unlocked .gift-item__card {
      border-color: #3D348B;
      border-style: solid;
    }
    /* Gold gradient overlay on unlocked gifts */
    .gift-item.is-unlocked .gift-item__card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, #FFDE99, #FFC966);
      opacity: 0.22;
      z-index: 0;
      pointer-events: none;
    }
    .gift-item__inner {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      padding: 8px;
    }
    /* Lock icon shown when locked */
    .gift-item__lock {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }
    .gift-item.is-unlocked .gift-item__lock {
      display: none;
    }
    .gift-item__lock-text {
      font-size: 10px;
      font-weight: 600;
      color: #9997AA;
    }
    /* Content shown when unlocked */
    .gift-item__content {
      display: none;
      flex-direction: column;
      align-items: center;
      width: 100%;
      height: 100%;
    }
    .gift-item.is-unlocked .gift-item__content {
      display: flex;
    }
    .gift-item__content img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .gift-item__placeholder-unlocked {
      font-size: 24px;
      color: #3D348B;
    }
    /* FREE badge */
    .gift-item__free-badge {
      position: absolute;
      top: 6px;
      left: 50%;
      transform: translateX(-50%);
      background: #2D8F2D;
      color: #FFFFFF;
      font-size: 9px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 4px;
      white-space: nowrap;
      z-index: 2;
    }
    /* Unlock progress text shown when locked */
    .gift-item__unlock-text {
      position: absolute;
      bottom: 6px;
      left: 0;
      right: 0;
      text-align: center;
      font-size: 9px;
      font-weight: 600;
      color: #9997AA;
      z-index: 2;
    }
    .gift-item.is-unlocked .gift-item__unlock-text {
      display: none;
    }
    .gift-item__name {
      font-size: 11px;
      font-weight: 600;
      color: #1A1A1A;
      line-height: 1.3;
    }
    .gift-item__value {
      font-size: 10px;
      color: #6B6B6B;
      text-decoration: line-through;
    }

    /* ===== CTA BUTTON ===== */
    .cta-section {
      padding: 0 24px 20px;
    }
    .cta-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      background: #CECDDA;
      color: #737097;
      font-size: 15px;
      font-weight: 700;
      padding: 16px;
      border-radius: 8px;
      border: none;
      font-family: inherit;
      transition: background 0.2s, color 0.2s, transform 0.15s;
      cursor: default;
    }
    .cta-btn.is-active {
      background: #3D348B;
      color: #FFFFFF;
      cursor: pointer;
    }
    .cta-btn.is-active:hover {
      background: #2A2552;
      transform: scale(1.01);
    }
    .cta-btn__arrow {
      font-size: 18px;
      display: none;
      transition: transform 0.2s;
    }
    .cta-btn.is-active .cta-btn__arrow {
      display: inline;
    }
    .cta-btn.is-active:hover .cta-btn__arrow {
      transform: translateX(4px);
    }

    /* ===== GUARANTEE ===== */
    .guarantee {
      padding: 0 24px 24px;
    }
    .guarantee__card {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 14px 16px;
      border: 1px solid #E0DDD8;
      border-radius: 8px;
      background: #FAF7F2;
    }
    .guarantee__icon {
      width: 22px;
      height: 22px;
      flex-shrink: 0;
      color: #2D8F2D;
      margin-top: 1px;
    }
    .guarantee__label {
      font-size: 11px;
      color: #6B6B6B;
      margin-bottom: 1px;
    }
    .guarantee__title {
      font-size: 14px;
      font-weight: 700;
      color: #1A1A1A;
      margin-bottom: 3px;
    }
    .guarantee__text {
      font-size: 12px;
      color: #6B6B6B;
      line-height: 1.5;
    }

    /* ===== FOOTER ===== */
    .page-footer {
      text-align: center;
      padding: 24px 20px;
      color: #6B6B6B;
      font-size: 12px;
      border-top: 1px solid #E0DDD8;
      margin-top: 8px;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 767px) {
      .main-layout {
        grid-template-columns: 1fr;
        gap: 0;
        padding: 16px 12px;
      }
      .marketing {
        display: none;
      }
      .shopping__headline { font-size: 19px; }
      .header-bar { gap: 10px; }
      .product-row { padding: 10px 16px; }
      .gift-section { padding: 14px 16px; }
      .cta-section { padding: 0 16px 16px; }
      .guarantee { padding: 0 16px 16px; }
      .shopping__header { padding: 16px 16px 8px; }
      .progress-section { padding: 0 16px 12px; }
      .trust-row { padding: 10px 16px; }
      .trust-row__sep { display: none; }
      .progress-milestone__label { font-size: 9px; }
    }
    @media (min-width: 768px) and (max-width: 991px) {
      .main-layout { gap: 28px; }
      .marketing__headline { font-size: 30px; }
    }
  </style>
</head>
<body>

  <!-- Top Banner -->
  <div class="top-banner">
    {{ section.settings.banner_text | default: 'SUMMER SALE — UP TO 40% OFF + FREE GIFTS' }}
  </div>

  <!-- Header Bar with countdown -->
  <div class="header-bar">
    <span class="header-bar__badge">&#9889; SUMMER SPECIAL</span>
    <span class="header-bar__sub">UP TO 40% OFF WITH FREE GIFTS</span>
    <div class="header-bar__timer-wrap">
      <div class="header-bar__timer">
        <span class="header-bar__timer-block" id="countdown-days">00</span>
        <span class="header-bar__timer-sep">:</span>
        <span class="header-bar__timer-block" id="countdown-hours">00</span>
        <span class="header-bar__timer-sep">:</span>
        <span class="header-bar__timer-block" id="countdown-minutes">00</span>
        <span class="header-bar__timer-sep">:</span>
        <span class="header-bar__timer-block" id="countdown-seconds">00</span>
      </div>
      <div class="header-bar__timer-labels">
        <span class="header-bar__timer-label">Days</span>
        <span class="header-bar__timer-label">Hrs</span>
        <span class="header-bar__timer-label">Min</span>
        <span class="header-bar__timer-label">Sec</span>
      </div>
    </div>
  </div>

  <!-- Main Layout: Two Columns -->
  <div class="main-layout">

    <!-- Left: Marketing Column (hidden on mobile) -->
    <div class="marketing">
      <h1 class="marketing__headline">{{ section.settings.headline | default: 'ENERGY THAT FUELS YOUR GAME' }}</h1>
      <p class="marketing__sub">{{ section.settings.subheadline | default: 'Sugar-Free &bull; 300mg Caffeine &bull; Focus + Energy Complex' }}</p>
      <div class="marketing__benefits">
        <div class="marketing__benefit">
          <span class="marketing__benefit-icon">&#9889;</span>
          Long-Lasting Energy, Zero Crash
        </div>
        <div class="marketing__benefit">
          <span class="marketing__benefit-icon">&#127775;</span>
          40 Servings Per Tub
        </div>
        <div class="marketing__benefit">
          <span class="marketing__benefit-icon">&#128170;</span>
          Focus &amp; Endurance Complex
        </div>
        <div class="marketing__benefit">
          <span class="marketing__benefit-icon">&#127807;</span>
          No Artificial Colors or Dyes
        </div>
      </div>
      <div class="marketing__hero-image">
        {% if section.settings.hero_image %}
          <img src="{{ section.settings.hero_image | image_url: width: 800 }}" alt="G FUEL" style="width:100%;height:100%;object-fit:contain;">
        {% else %}
          [Hero Product Image]
        {% endif %}
      </div>
      <div class="marketing__testimonial">
        <div class="marketing__testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <div class="marketing__testimonial-label">Obsessed</div>
        <p class="marketing__testimonial-quote">"I've tried every energy drink out there and nothing comes close. The flavors are incredible, no crash, and the tubs last forever. Already on my third order!"</p>
        <div class="marketing__testimonial-author">
          <div class="marketing__testimonial-avatar"></div>
          <div>
            <div class="marketing__testimonial-name">Alex M.</div>
            <div class="marketing__testimonial-verified">&#10003; Verified Buyer</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: Shopping Column -->
    <div class="shopping" id="shopping">

      <!-- Trust Row -->
      <div class="trust-row">
        <div class="trust-row__item">
          <span class="trust-row__label">No Subscription</span>
          <span class="trust-row__sublabel">Same great price</span>
        </div>
        <div class="trust-row__sep"></div>
        <div class="trust-row__item">
          <div class="trust-row__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <span class="trust-row__label">&ldquo;Excellent&rdquo;</span>
          <span class="trust-row__sublabel">12,000+ reviews</span>
        </div>
        <div class="trust-row__sep"></div>
        <div class="trust-row__item">
          <span class="trust-row__label">Crave-Worthy</span>
          <span class="trust-row__sublabel">Flavor you&rsquo;ll want again</span>
        </div>
      </div>

      <!-- Shopping Header -->
      <div class="shopping__header">
        <h2 class="shopping__headline">Save Up To <span>40%</span> Today With <span>FREE</span> Gifts</h2>
        <div class="discount-label">
          <span class="discount-label__dot"></span>
          SUMMER DISCOUNT ACTIVE
        </div>
      </div>

      <!-- Progress Bar -->
      <div class="progress-section">
        <!-- Milestone dots -->
        <div class="progress-milestones">
          <div class="progress-milestone" data-milestone="1">
            <div class="progress-milestone__dot"></div>
          </div>
          <div class="progress-milestone" data-milestone="2">
            <div class="progress-milestone__dot"></div>
            <span class="progress-milestone__badge progress-milestone__badge--popular">Popular</span>
          </div>
          <div class="progress-milestone" data-milestone="3">
            <div class="progress-milestone__dot"></div>
          </div>
          <div class="progress-milestone" data-milestone="4">
            <div class="progress-milestone__dot"></div>
            <span class="progress-milestone__badge progress-milestone__badge--best">Best Deal</span>
          </div>
        </div>
        <!-- Fill bar -->
        <div class="progress-bar">
          <div class="progress-bar__track">
            <div class="progress-bar__segment" data-meter="1"></div>
            <div class="progress-bar__segment" data-meter="2"></div>
            <div class="progress-bar__segment" data-meter="3"></div>
            <div class="progress-bar__segment" data-meter="4"></div>
          </div>
        </div>
        <!-- Prices below -->
        <div class="progress-prices">
          <div class="progress-price" data-price-tier="1" id="price-tier-1">
            <div>$35.99/ea</div>
          </div>
          <div class="progress-price" data-price-tier="2" id="price-tier-2">
            <div>$25.19/ea</div>
            <div class="progress-price__discount">30% off</div>
          </div>
          <div class="progress-price" data-price-tier="3" id="price-tier-3">
            <div>$23.39/ea</div>
            <div class="progress-price__discount">35% off</div>
          </div>
          <div class="progress-price" data-price-tier="4" id="price-tier-4">
            <div>$21.59/ea</div>
            <div class="progress-price__discount">40% off</div>
          </div>
        </div>
      </div>

      <!-- Product List -->
      <div class="product-list" id="product-list">
        <!-- Rendered by JS -->
      </div>

      <!-- Gift Section -->
      <div class="gift-section">
        <div class="gift-section__header">
          <span class="gift-section__title">FREE Gifts with Your Order</span>
          <span class="gift-section__badge">SUMMER SPECIAL</span>
        </div>
        <div class="gift-section__deadline">Exclusive gifts on orders placed by May 1st</div>
        <div class="gift-section__grid" id="gift-grid">

          <!-- Gift 0: Sampler Sticks (unlocks at 2) -->
          <div class="gift-item" id="gift-0" data-gift-min="2">
            <div class="gift-item__card">
              <span class="gift-item__free-badge">FREE $9.95</span>
              <div class="gift-item__inner">
                <div class="gift-item__lock">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#CFCFCF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                  <span class="gift-item__lock-text">2+ Tubs</span>
                </div>
                <div class="gift-item__content">
                  {% if section.settings.gift_1_image %}
                    <img src="{{ section.settings.gift_1_image | image_url: width: 200 }}" alt="Sampler Sticks">
                  {% else %}
                    <span class="gift-item__placeholder-unlocked">&#127867;</span>
                  {% endif %}
                </div>
              </div>
              <span class="gift-item__unlock-text">Add 2+ tubs</span>
            </div>
            <div class="gift-item__name">Sampler Sticks</div>
            <div class="gift-item__value">$9.95 value</div>
          </div>

          <!-- Gift 1: Shaker Cup (unlocks at 3) -->
          <div class="gift-item" id="gift-1" data-gift-min="3">
            <div class="gift-item__card">
              <span class="gift-item__free-badge">FREE $14.95</span>
              <div class="gift-item__inner">
                <div class="gift-item__lock">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#CFCFCF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                  <span class="gift-item__lock-text">3+ Tubs</span>
                </div>
                <div class="gift-item__content">
                  {% if section.settings.gift_2_image %}
                    <img src="{{ section.settings.gift_2_image | image_url: width: 200 }}" alt="Shaker Cup">
                  {% else %}
                    <span class="gift-item__placeholder-unlocked">&#127863;</span>
                  {% endif %}
                </div>
              </div>
              <span class="gift-item__unlock-text">Add 3+ tubs</span>
            </div>
            <div class="gift-item__name">Shaker Cup</div>
            <div class="gift-item__value">$14.95 value</div>
          </div>

          <!-- Gift 2: Free Shipping (unlocks at 2) -->
          <div class="gift-item" id="gift-2" data-gift-min="2">
            <div class="gift-item__card">
              <span class="gift-item__free-badge">FREE $5.95</span>
              <div class="gift-item__inner">
                <div class="gift-item__lock">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#CFCFCF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                  <span class="gift-item__lock-text">2+ Tubs</span>
                </div>
                <div class="gift-item__content">
                  {% if section.settings.gift_3_image %}
                    <img src="{{ section.settings.gift_3_image | image_url: width: 200 }}" alt="Free Shipping">
                  {% else %}
                    <span class="gift-item__placeholder-unlocked">&#128666;</span>
                  {% endif %}
                </div>
              </div>
              <span class="gift-item__unlock-text">Add 2+ tubs</span>
            </div>
            <div class="gift-item__name">Free Shipping</div>
            <div class="gift-item__value">$5.95 value</div>
          </div>

        </div>
      </div>

      <!-- CTA Button -->
      <div class="cta-section">
        <button class="cta-btn" id="cta-btn" disabled>
          <span id="cta-text">Select at least 1 tub</span>
          <span class="cta-btn__arrow">&#8594;</span>
        </button>
      </div>

      <!-- Guarantee -->
      <div class="guarantee">
        <div class="guarantee__card">
          <svg class="guarantee__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
          <div>
            <div class="guarantee__label">Your order is protected by</div>
            <div class="guarantee__title">30-Day Money-Back Guarantee</div>
            <div class="guarantee__text">If for any reason you don&rsquo;t love your G FUEL, you can return it for a full refund. No questions asked.</div>
          </div>
        </div>
      </div>

    </div><!-- /shopping -->
  </div><!-- /main-layout -->

  <!-- Footer -->
  <footer class="page-footer">
    &copy; 2026 G FUEL. All rights reserved.
  </footer>

  <script>
    window.GFUEL_SALE_END = {{ section.settings.sale_end_date | default: '2026-05-01T23:59:59' | json }};
    window.GFUEL_BASE_PRICE = {{ section.settings.base_price | default: '35.99' | times: 1.0 }};
    window.GFUEL_PRODUCTS = [
      {% for product in section.settings.collection.products %}
      {
        id: {{ product.id }},
        title: {{ product.title | json }},
        desc: {{ product.description | strip_html | truncate: 80 | json }},
        image: {{ product.featured_image | image_url: width: 200 | json }},
        badge: '{% if product.tags contains "new" %}new{% elsif product.tags contains "best-seller" %}bestseller{% elsif product.tags contains "back-in-stock" %}backinstock{% elsif product.tags contains "gone-forever" %}gone{% elsif product.variants.first.inventory_quantity <= 5 and product.variants.first.inventory_quantity > 0 %}lowstock{% endif %}',
        price: {{ product.price | times: 1.0 | divided_by: 100.0 }},
        rating: 4.8,
        stock: {{ product.variants.first.inventory_quantity | default: 99 }}
      }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ];
  </script>
  {{ 'gfuel-lander.js' | asset_url | script_tag }}
</body>
</html>

{% schema %}
{
  "name": "BMSM Lander",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Product Collection",
      "info": "Choose which collection of products to display in the lander"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Product Image",
      "info": "Main product image shown in the left marketing column"
    },
    {
      "type": "image_picker",
      "id": "gift_1_image",
      "label": "Gift 1 Image (Sampler Sticks)",
      "info": "Image for the mystery sampler sticks gift"
    },
    {
      "type": "image_picker",
      "id": "gift_2_image",
      "label": "Gift 2 Image (Shaker Cup)",
      "info": "Image for the shaker cup gift"
    },
    {
      "type": "image_picker",
      "id": "gift_3_image",
      "label": "Gift 3 Image (Free Shipping)",
      "info": "Image for the free shipping gift"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Hero Headline",
      "default": "ENERGY THAT FUELS YOUR GAME"
    },
    {
      "type": "text",
      "id": "subheadline",
      "label": "Hero Subheadline",
      "default": "Sugar-Free • 300mg Caffeine • Focus + Energy"
    },
    {
      "type": "text",
      "id": "sale_end_date",
      "label": "Sale End Date",
      "default": "2026-05-01T23:59:59",
      "info": "Format: YYYY-MM-DDTHH:MM:SS"
    },
    {
      "type": "text",
      "id": "base_price",
      "label": "Base Price Per Tub ($)",
      "default": "35.99"
    },
    {
      "type": "text",
      "id": "banner_text",
      "label": "Top Banner Text",
      "default": "SUMMER SALE — UP TO 40% OFF + FREE GIFTS"
    }
  ],
  "presets": [
    {
      "name": "BMSM Lander"
    }
  ]
}
{% endschema %}
